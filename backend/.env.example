# 環境配置範例文件
# 複製此文件為 .env 並修改相應的值

# ===========================================
# 生產環境控制標誌
# ===========================================
# 設定為 true 時：
# - 跳過 CORS 配置（讓 HF Spaces 處理）
# - 使用 HF Spaces 注入的資料庫環境變數
# 設定為 false 時：
# - 啟用開發環境 CORS 配置（支持本地和手機測試）
# - 使用本地資料庫配置
PRODUCTION=false

# ===========================================
# 本地開發環境配置
# ===========================================
# 本地資料庫連線字串
DATABASE_URL=postgresql://postgres:123456@localhost:5432/inventory_db_fastapi

# ===========================================
# Hugging Face Spaces 部署配置
# ===========================================
# 在 HF Spaces Settings 中添加以下環境變量：
# PRODUCTION=true
# DB_HOST=<HF提供的主機名>
# DB_PORT=6543
# DB_NAME=<HF提供的資料庫名>
# DB_USER=<HF提供的用戶名>
# DB_PASSWORD=<HF提供的密碼>

# 其他配置...
